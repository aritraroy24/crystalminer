# crystalminer's web version on Apache or LiteSpeed (Hostinger): no folder listings, compressed data, and cached textures.
Options -Indexes
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json text/javascript application/javascript text/css text/html image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 7 days"
</IfModule>
# Never serve a key file that was uploaded here by mistake.
<FilesMatch "^(\.env.*|crystalminer-config\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
