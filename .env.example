# Copy this file to .env (next to it, or in the folder above the game) and start Luanti with tools/luanti_with_env.cmd. Only the key of the provider you use is needed. .env is ignored by git; never commit a real key.

# The tutor's model, as provider/model (see "The AI tutor" in the README). Empty: deepseek/deepseek-flash.
CRYSTALMINER_TUTOR_MODEL=deepseek/deepseek-flash

DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHERAI_API_KEY=
# XAI_API_KEY=
# FIREWORKS_AI_API_KEY=
# PERPLEXITYAI_API_KEY=
# CEREBRAS_API_KEY=

# A LiteLLM proxy, for litellm_proxy/<model>:
# LITELLM_PROXY_API_BASE=http://localhost:4000
# LITELLM_PROXY_API_KEY=

# A local server somewhere other than this computer's usual address:
# OLLAMA_API_BASE=http://localhost:11434
